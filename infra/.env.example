# Copie para .env e preencha. O .env nunca vai pro repositorio.

GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=troque-por-uma-senha-forte

# 127.0.0.1 = so esta maquina. Pra acessar pela tailnet, coloque o IP
# Tailscale da maquina (ex.: 100.x.y.z).
GEOSERVER_BIND_IP=127.0.0.1
GEOSERVER_PORT=8080

# --- Stack com PostGIS em Docker (docker-compose.stack.yml) ---
# Senha do superusuario 'postgres' do contêiner (so vale na 1a criacao do volume).
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# 127.0.0.1 = so esta maquina; IP Tailscale pra expor na tailnet.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432
# Como o GeoServer alcanca o banco: "postgis" na stack Docker;
# "host.docker.internal" quando o Postgres e nativo no Windows.
GEOSERVER_DB_HOST=postgis

# --- Contêiner Tailscale (docker-compose.tailscale.yml) ---
# Chave de autenticacao do console do Tailscale: de USO UNICO e validade curta.
# So na primeira subida; depois pode ser apagada daqui.
TS_AUTHKEY=tskey-auth-...
# Nome do no na tailnet (teste: dw-sidecar-teste; definitivo: datawarehouse).
TS_HOSTNAME=dw-sidecar-teste

# Senha do papel de banco 'geoserver' (somente leitura). So e usada pelo
# publicar_geoserver.py quando precisa CRIAR um store PostGIS (GeoServer novo);
# store ja existente e mantido sem reenviar a senha.
GEOSERVER_DB_PASSWORD=senha-do-papel-geoserver
